{
  "name": "krewtree-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:rls": "node scripts/check-rls-policies.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "build:auth-emails": "tsx --tsconfig ./api/tsconfig.json scripts/build-auth-emails.mts",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "db:status": "supabase projects list",
    "db:link:dev": "supabase link --project-ref ryigaxihlfqdwgjbgmcg",
    "db:link:prod": "supabase link --project-ref ivbmjtngsasrlblzhfxj",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:reset:local": "supabase db reset"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/react": "^10.69.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@supabase/supabase-js": "^2.100.0",
    "lottie-react": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@figma/code-connect": "^1.4.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.1.2",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "tsx": "^4.23.9",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^5.4.1",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ],
    "supabase/migrations/*.sql": [
      "node scripts/check-rls-policies.mjs"
    ]
  }
}
