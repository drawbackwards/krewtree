# ─────────────────────────────────────────────────────────────
# krewtree environment variables — copy to .env.local and fill in
# ─────────────────────────────────────────────────────────────
#
# Two Supabase lanes exist (see ENVIRONMENTS.md):
#   • dev  — hosted project ref `ryigaxihlfqdwgjbgmcg` (has test data)
#   • prod — separate project, clean, Pro tier, "Confirm email" ON
#
# Local development ALWAYS points at dev. Prod values live only in
# Vercel's Production environment, never in a local file.
#
# Vercel:
#   • Production           → prod project URL + anon key
#   • Preview / Development → dev  project URL + anon key
# ─────────────────────────────────────────────────────────────

# Supabase — Dashboard → Project Settings → API
# Use the DEV project values here for local work.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Feature flags
# Regulix partner integration. Keep 'false' until the Regulix connection is
# live — when off, all Regulix badges, "Regulix Preferred" jobs, endorsements,
# nudges, status boxes, and Regulix-only filters are hidden. Set to 'true' to
# enable. Requires a redeploy to take effect (build-time flag).
VITE_ENABLE_REGULIX=false

# ── Email (Resend) — not wired yet; DNS/domain verification pending ──
# Full setup checklist: docs/EMAIL_SETUP.md
# Server-side only (Vercel function). NOT prefixed VITE_ — must never reach
# the browser bundle. Use per-environment keys: dev key locally + Vercel
# Preview/Dev, prod key in Vercel Production.
# RESEND_API_KEY=
# EMAIL_FROM must be onboarding@resend.dev until mail.krewtree.com verifies,
# then flip to noreply@mail.krewtree.com.
# EMAIL_FROM=onboarding@resend.dev
#
# Origin the /api/send-invite function uses to build the join link. Optional —
# defaults to the request's own host (correct on Vercel). Set only to force a
# specific origin. NOT VITE_-prefixed (server-side only).
# PUBLIC_SITE_URL=https://krewtree-app.vercel.app

# ── Error monitoring (Sentry) — dormant until DSN is set ──
# Client DSN — safe in the browser bundle. Reports only from deployed builds
# (never local dev). Leave unset and Sentry stays a no-op.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production   # set to "preview" on Vercel Preview
#
# Build-time source-map upload — server-side, NOT VITE_-prefixed. Set these in
# Vercel (Production + Preview) so minified stack traces resolve to TS source.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
